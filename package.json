{
  "name": "suikou",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "fmt": "oxfmt --write .",
    "lint": "oxlint app pages tests scripts next.config.js postcss.config.js && npm run lint:design",
    "check": "oxfmt --check . && npm run lint && npm run typecheck && npm test",
    "build": "npm run lint:design && next build",
    "build:netlify": "npm run build",
    "dev": "next dev",
    "dev:netlify": "decap-server",
    "export": "npm run build",
    "start": "serve out -l 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts tests/*.test.tsx",
    "lint:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "firebase": "12.18.0",
    "gray-matter": "4.0.3",
    "input-otp": "1.5.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "decap-server": "3.11.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "postcss": "8.5.28",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
